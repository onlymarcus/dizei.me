# ─────────────────────────────────────────────────────────────────
# Meta Embedded Signup — Frontend (Next.js build-time)
# Configurar no painel da Cloudflare Pages → Settings → Environment variables
# Esses valores sao inlined no bundle cliente durante o build.
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=

# ─────────────────────────────────────────────────────────────────
# Meta Embedded Signup — Backend (Cloudflare Pages Function, runtime)
# Configurar como variaveis de ambiente NO SERVIDOR no painel da Cloudflare.
# META_APP_SECRET nunca deve aparecer no bundle cliente.
# ─────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
