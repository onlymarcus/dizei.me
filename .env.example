# ─────────────────────────────────────────────────────────────────
# Meta Embedded Signup — Frontend (Next.js build-time)
# Configurar no painel da Cloudflare Pages → Settings → Environment variables
# Esses valores sao inlined no bundle cliente durante o build.
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=

# ─────────────────────────────────────────────────────────────────
# Meta Embedded Signup — Backend (Cloudflare Pages Function, runtime)
# Configurar como variaveis de ambiente NO SERVIDOR no painel da Cloudflare.
# META_APP_SECRET e ADMIN_SECRET nunca devem aparecer no bundle cliente.
# ─────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# Segredo para proteger o endpoint de geracao de links de onboarding.
# Use qualquer string longa e aleatoria. Mantenha privado.
ADMIN_SECRET=

# URL do webhook n8n para receber o token apos o onboarding (opcional por enquanto).
# Exemplo: https://n8n.seudominio.com/webhook/dizei-onboarding
N8N_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────
# Meta Pixel — Frontend (Next.js build-time)
# Inlined no bundle cliente. Sem isso o Pixel nao e injetado e
# trackEvent() vira no-op.
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────
# Meta API de Conversoes — Backend (Cloudflare Pages Function, runtime)
# META_CAPI_ACCESS_TOKEN e segredo: nunca prefixar com NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Preencher SO enquanto estiver usando "Testar eventos" no Gerenciador
# de Eventos. Com este codigo preenchido os eventos aparecem apenas na
# aba de teste e NAO contam como conversao real. Limpar depois do teste.
META_CAPI_TEST_EVENT_CODE=
